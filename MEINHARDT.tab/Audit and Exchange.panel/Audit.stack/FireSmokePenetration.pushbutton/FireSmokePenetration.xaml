<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MHT DUCT/WALL CLASH DETECTION" Height="720" Width="920"
        WindowStartupLocation="CenterScreen" Background="#1A1A1C" Foreground="#E8E8E8">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0E639C"/><SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1177BB"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1FA6A6"/><SolidColorBrush x:Key="AccentBrush" Color="#F2B134"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/><SolidColorBrush x:Key="SurfaceBrush" Color="#232327"/><SolidColorBrush x:Key="InputBrush" Color="#1E1E22"/>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="4"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource SecondaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/></Style>
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#1A1A1C"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Style>
    </Window.Resources>
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="DUCT/WALL CLASH DETECTION" FontSize="19" FontWeight="Bold" Foreground="#E8E8E8" Margin="0,0,0,10"/>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <GroupBox Header="Analysis scope"><StackPanel><ComboBox x:Name="scope_box"><ComboBoxItem Content="Active model" IsSelected="True"/><ComboBoxItem Content="Active view"/></ComboBox><CheckBox x:Name="include_links_box" Content="Include architectural and applicable MEP links" IsChecked="True"/><CheckBox x:Name="fire_only_box" Content="Fire-rated walls only"/><CheckBox x:Name="smoke_only_box" Content="Smoke-rated walls only"/><CheckBox x:Name="dry_run_box" Content="Dry run (do not place markers)" IsChecked="True"/></StackPanel></GroupBox>
                <GroupBox Header="Wall classification parameters">
                    <StackPanel>
                        <TextBlock Text="Enter exact parameter names. Separate alternatives with commas, semicolons, or new lines. The primary lookup is NWB_Material." Foreground="#8A8A9A" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Fire parameter(s)" VerticalAlignment="Top" Margin="0,5,6,5"/>
                            <TextBlock Grid.Row="1" Text="Smoke parameter(s)" VerticalAlignment="Top" Margin="0,5,6,5"/>
                            <TextBlock Grid.Row="2" Text="Combined / NWB parameter(s)" VerticalAlignment="Top" Margin="0,5,6,5"/>
                            <TextBox x:Name="fire_param_box" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" Margin="0,2"/>
                            <TextBox x:Name="smoke_param_box" Grid.Column="1" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" Margin="0,2"/>
                            <TextBox x:Name="combined_param_box" Grid.Column="1" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" Margin="0,2" Text="NWB_Material"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Geometry"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Numerical tolerance (mm)"/><TextBlock Grid.Row="1" Text="Duplicate tolerance (mm)"/><TextBlock Grid.Row="2" Text="Reconciliation tolerance (mm)"/><TextBox x:Name="tolerance_box" Grid.Column="1" Text="3"/><TextBox x:Name="duplicate_box" Grid.Column="1" Grid.Row="1" Text="50"/><TextBox x:Name="reconcile_box" Grid.Column="1" Grid.Row="2" Text="50"/></Grid></GroupBox>
                <GroupBox Header="Marker prerequisite"><TextBlock Text="Marker family"/><TextBox x:Name="marker_family_box"/><TextBlock Text="Marker symbol"/><TextBox x:Name="marker_symbol_box"/><TextBlock Text="Placement remains blocked until this family and symbol are supplied and validated." Foreground="#F2B134" TextWrapping="Wrap" Margin="0,5,0,0"/></GroupBox>
            </StackPanel>
            <Grid Grid.Column="1" Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Findings and diagnostics" FontWeight="Bold" FontSize="14"/><TextBox x:Name="results_box" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="export_button" Content="Export CSV"/><Button x:Name="analyze_button" Content="Analyze" Style="{StaticResource PrimaryButton}"/><Button x:Name="place_button" Content="Place / Reconcile Markers" Style="{StaticResource WarningButton}"/><Button x:Name="close_button" Content="Close"/></StackPanel>
    </Grid>
</Window>
