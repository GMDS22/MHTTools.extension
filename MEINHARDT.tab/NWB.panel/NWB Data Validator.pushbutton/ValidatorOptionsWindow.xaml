<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NWB Data Validator By GM - Setup"
        Width="650"
        Height="540"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="#1A1A1C"
        Foreground="#E8E8E8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#232327"/>
        <SolidColorBrush x:Key="FieldBg" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/>
        <SolidColorBrush x:Key="ControlHoverBg" Color="#2B2B31"/>
        <SolidColorBrush x:Key="ControlBorderStrong" Color="#55555E"/>
        <SolidColorBrush x:Key="MutedText" Color="#8A8A9A"/>
        <SolidColorBrush x:Key="Primary" Color="#0E639C"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#1177BB"/>
        <SolidColorBrush x:Key="Secondary" Color="#1FA6A6"/>
        <SolidColorBrush x:Key="SecondarySurface" Color="#1B3030"/>
        <SolidColorBrush x:Key="Accent" Color="#F2B134"/>
        <SolidColorBrush x:Key="AccentSurface" Color="#362E1B"/>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="8,2,6,2" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                <Border Grid.Column="1" Background="{StaticResource ControlHoverBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" IsHitTestVisible="False"><Path Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#E8E8E8" Data="M 0 0 L 5 5 L 10 0 Z"/></Border>
                                <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press" Background="Transparent" BorderBrush="Transparent" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="{StaticResource FieldBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer SnapsToDevicePixels="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource ControlHoverBg}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#3A3A40"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ControlHoverBg}"/><Setter Property="BorderBrush" Value="{StaticResource Secondary}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource FieldBg}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Secondary}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHover}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryHover}"/><Setter Property="BorderBrush" Value="{StaticResource Secondary}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#0A4D78"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="NWB Data Validator" FontSize="20" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,14" Foreground="{StaticResource MutedText}" Text="Review workbook-derived NWB values without modifying the Revit model."/>
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Validation Scope" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,10,0" Text="Active view"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtActiveView" IsReadOnly="True"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,10,0" Text="Selected MEP elements"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtSelectedCount" IsReadOnly="True"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,10,0" Text="Processing scope"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cmbProcessingScope"/>
                    <Border Grid.Row="4" Grid.Column="1" Background="{StaticResource SecondarySurface}" BorderBrush="{StaticResource Secondary}" BorderThickness="1" Padding="8" Margin="0,2,0,0"><TextBlock Foreground="#E8E8E8" Text="The active-view option evaluates all eligible MEP elements visible in the current model view or schedule."/></Border>
                </Grid>
            </Border>
            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Validation Rules" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,10,0" Text="Parameter targets"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbParameterTargetMode"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,10,0" Text="Arch room link"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbArchitecturalRoomLink"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,10,0" Text="Report format"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cmbOutputFormat"/>
                    <Border Grid.Row="4" Grid.Column="1" Background="{StaticResource AccentSurface}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="8" Margin="0,2,0,0"><TextBlock Foreground="#E8E8E8" Text="Read-only check: results are exported using a reusable template in the tool directory; no model values are changed."/></Border>
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="cancel_click"/>
            <Button Content="Export Validation Report" Style="{StaticResource PrimaryButton}" Click="start_click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>