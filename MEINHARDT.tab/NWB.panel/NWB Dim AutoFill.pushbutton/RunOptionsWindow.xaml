<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NWB Dim AutoFill by GM - Setup"
        Width="780"
        Height="560"
        MinWidth="700"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#1A1A1C"
        Foreground="#E8E8E8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#232327"/>
        <SolidColorBrush x:Key="FieldBg" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/>
        <SolidColorBrush x:Key="MutedText" Color="#A5A7AE"/>
        <SolidColorBrush x:Key="Primary" Color="#0E639C"/>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"/>
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="8,2,6,2"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                                <Border Grid.Column="1"
                                        Background="#2B2B31"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1,0,0,0"
                                        IsHitTestVisible="False">
                                    <Path Width="10"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="#E8E8E8"
                                          Data="M 0 0 L 5 5 L 10 0 Z"/>
                                </Border>

                                <ToggleButton Grid.ColumnSpan="2"
                                              Focusable="False"
                                              ClickMode="Press"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Background="{StaticResource FieldBg}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2B2B31"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Primary}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#3A3A40"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#55555E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NWB Dim AutoFill" FontSize="20" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,14" Foreground="{StaticResource MutedText}"
                   Text="Choose all processing options in one place before starting the dimension auto-fill run."/>

        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Run Options" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,10,0" Text="Write mode"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbWriteMode"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,4,10,0" Text="Parameter target mode"/>
                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbParameterTargetMode"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,10,0" Text="Worksharing mode"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbWorksharingMode"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,4,10,0" Text="Processing scope"/>
                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="cmbProcessingScope"/>

                    <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="chkExportAudit" Margin="0,10,0,0"
                              Content="Export detailed audit CSV for this run (recommended)"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="chkFastMode" Margin="0,4,0,0"
                              Content="Fast mode: disable live monitor and per-element runtime logging"/>
                </Grid>
            </Border>

            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Context" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,10,0" Text="Active view"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtActiveView" IsReadOnly="True"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,4,10,0" Text="Selected MEP elements"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtSelectedCount" IsReadOnly="True"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="cancel_click" Width="110"/>
            <Button Content="Start" Click="start_click" Width="140" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
