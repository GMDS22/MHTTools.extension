<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category Instance Parameters"
        Height="780"
        Width="1060"
        MinWidth="920"
        MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Loaded="window_loaded"
        SizeChanged="window_size_changed"
        ResizeMode="CanResize"
        Background="#1A1A1C"
        Foreground="#E8E8E8">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#232327"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A9A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0E639C"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1FA6A6"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#3A3A40"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#505058"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22B8B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ApplyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#E8E8E8"/>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="BtnBorder"
                    Background="#2A2A2E"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#33333A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"/>
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="#E8E8E8"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#303036"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#303036"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="8,2,28,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E8E8E8"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1E1E22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Category Instance Parameter Update"
                       FontSize="18" FontWeight="Bold" Foreground="#E8E8E8"
                       Margin="0,0,0,2"/>
            <TextBlock Grid.Row="1" Style="{StaticResource Hint}"
                       Text="Select categories, collect elements, choose target parameter, then apply direct value or source processing mode."
                       Margin="0,0,0,10"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.34*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.66*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="1. Select Categories" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Filter and tick categories to include in this batch."/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox x:Name="txtCategorySearch" Width="150"
                                     TextChanged="category_search_changed"
                                     ToolTip="Type a keyword to filter categories"/>
                            <Button Content="All" Click="select_all_categories_click" MinWidth="44"/>
                            <Button Content="None" Click="deselect_all_categories_click" MinWidth="44" Margin="0"/>
                        </StackPanel>

                        <ListBox x:Name="lstCategories" MinHeight="240" MaxHeight="420"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionCard}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Operation Mode:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#B0B0B8"/>
                            <ComboBox x:Name="cmbOperationMode" Width="360" SelectionChanged="operation_mode_changed" SelectedIndex="0">
                                <ComboBoxItem Content="Direct Set Value (Current Mode)"/>
                                <ComboBoxItem Content="Copy/Process Source Parameter (New Mode)"/>
                                <ComboBoxItem Content="Copy/Process From Matched Element (Mode 3)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="2. Collect Elements" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Collect by selected categories from active view or entire model. Use current Revit selection if preferred."
                                       Margin="0,2,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                <ComboBox x:Name="cmbCollectScope" Width="200" SelectedIndex="0" SelectionChanged="collect_scope_changed">
                                    <ComboBoxItem Content="Active View Only"/>
                                    <ComboBoxItem Content="Selected Level"/>
                                    <ComboBoxItem Content="Entire Model"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="pnlSelectedLevel" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                                <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                <ComboBox x:Name="cmbSelectLevel" Width="280" ToolTip="Choose the level used when Scope is set to Selected Level."/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Collect Elements" Click="collect_elements_click" Style="{StaticResource PrimaryButton}" Width="160"/>
                                <Button Content="Use Current Selection" Click="use_current_selection_click" Width="170"/>
                            </StackPanel>

                            <Border Background="#1E1E22" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Padding="8,6">
                                <TextBlock x:Name="txtElementSummary" Style="{StaticResource Hint}"
                                           Foreground="#D8D8D8"
                                           Text="No elements collected yet."/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="3. Choose Instance Parameter" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Only writable instance parameters common to all collected elements are shown." Margin="0,2,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="lstCommonParams" Grid.Column="0" MinHeight="120" MaxHeight="260"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Parameter to update:" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbParameter" Height="26" SelectionChanged="parameter_selection_changed"/>
                                    <Border Margin="0,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Background="#1E1E22">
                                        <TextBlock x:Name="txtSelectedParameterInfo" Style="{StaticResource Hint}"
                                                   Foreground="#D8D8D8"
                                                   Text="No parameter selected."/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border x:Name="pnlDirectValueMode" Style="{StaticResource SectionCard}">
                                <StackPanel>
                            <TextBlock Text="4. Set Value and Apply" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Text="For String parameters, duplicate mode can append or skip when a value already exists." Margin="0,2,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="New value:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                <TextBox x:Name="txtValue" Width="300" ToolTip="For ElementId, enter the integer ElementId value."/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="chkClearValue" Content="Clear value instead of writing new value"
                                          Checked="clear_value_changed" Unchecked="clear_value_changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Duplicate mode:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                <ComboBox x:Name="cmbDuplicateMode" Width="220" SelectedIndex="0">
                                    <ComboBoxItem Content="Overwrite"/>
                                    <ComboBoxItem Content="Skip Existing"/>
                                    <ComboBoxItem Content="Append (String only)"/>
                                </ComboBox>
                                <TextBlock Text="Non-string parameters always overwrite." VerticalAlignment="Center" Style="{StaticResource Hint}" Foreground="#B0B0B8"/>
                            </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="pnlSourceProcessMode" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="4. Source to Target Processing Mode" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="Mode flow: 1) get source values, 2) manipulate or keep values, 3) write to selected target parameter." Margin="0,2,0,8"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border x:Name="pnlMode3SourceOptions" Margin="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Background="#1E1E22" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Mode 3: Source from other element" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Source model:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                                <ComboBox x:Name="cmbMode3SourceLocation" Width="210" SelectionChanged="mode3_source_options_changed" SelectedIndex="0">
                                                    <ComboBoxItem Content="Current Model"/>
                                                    <ComboBoxItem Content="Linked Model"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel x:Name="pnlMode3LinkSelection" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                                                <TextBlock Text="Linked source:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                                <ComboBox x:Name="cmbMode3LinkInstance" Width="280" SelectionChanged="mode3_source_options_changed"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Target match key:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                                <ComboBox x:Name="cmbMode3TargetMatchParameter" Width="260" SelectionChanged="mode3_source_options_changed"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Source match key:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                                <ComboBox x:Name="cmbMode3SourceMatchParameter" Width="260" SelectionChanged="mode3_source_options_changed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="txtMode3Status" Style="{StaticResource Hint}" Foreground="#D8D8D8"
                                                       Text="Mode 3 not configured yet."/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Step 1: Source parameter" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="cmbSourceParameter" Height="26" SelectionChanged="source_parameter_changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                        <Button Content="Preview Source Values" Click="preview_source_values_click" Width="170"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chkExportMappedPreviewCsv"
                                                  Content="Export mapped preview to CSV"
                                                  Checked="persist_inputs_changed"
                                                  Unchecked="persist_inputs_changed"/>
                                    </StackPanel>
                                    <ListBox x:Name="lstSourcePreview" MinHeight="120" MaxHeight="260"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Step 2: Manipulate value" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="cmbValueTransform" Height="26" SelectionChanged="value_transform_changed">
                                        <ComboBoxItem Content="Keep Original"/>
                                        <ComboBoxItem Content="Convert To String"/>
                                        <ComboBoxItem Content="Digits Only"/>
                                        <ComboBoxItem Content="Pad Number (Width)"/>
                                        <ComboBoxItem Content="Digits + Pad Number"/>
                                        <ComboBoxItem Content="Level Number (2-digit)"/>
                                        <ComboBoxItem Content="Level Number (3-digit)"/>
                                        <ComboBoxItem Content="Uppercase"/>
                                        <ComboBoxItem Content="Lowercase"/>
                                        <ComboBoxItem Content="Title Case"/>
                                        <ComboBoxItem Content="Trim Spaces"/>
                                        <ComboBoxItem Content="Remove Spaces"/>
                                        <ComboBoxItem Content="Left 3 Characters"/>
                                        <ComboBoxItem Content="Replace String"/>
                                        <ComboBoxItem Content="Dictionary (Translate)"/>
                                        <ComboBoxItem Content="Template (Tokens)"/>
                                        <ComboBoxItem Content="Formula (Safe Numeric)"/>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                        <TextBlock Text="Pad Width:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                        <TextBox x:Name="txtPadWidth" Width="80" Text="2" TextChanged="persist_inputs_changed"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Prefix:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                        <TextBox x:Name="txtPrefix" Width="110" TextChanged="persist_inputs_changed"/>
                                        <TextBlock Text="Suffix:" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="#B0B0B8"/>
                                        <TextBox x:Name="txtSuffix" Width="110" TextChanged="persist_inputs_changed"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Text to replace:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                        <TextBox x:Name="txtReplaceFrom" Width="110" TextChanged="persist_inputs_changed" ToolTip="Exact text to find in the source value."/>
                                        <TextBlock Text="Replacement text:" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="#B0B0B8"/>
                                        <TextBox x:Name="txtReplaceTo" Width="110" TextChanged="persist_inputs_changed" ToolTip="Text to write in place of each match. Leave blank to remove the match."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Expression:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B0B0B8"/>
                                        <TextBox x:Name="txtExpression" Width="236" Height="68" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                 TextChanged="persist_inputs_changed"
                                                 ToolTip="Template: {value}-{level_number}. Formula: value*10 + level. Dictionary: key=value per line."/>
                                    </StackPanel>
                                    <Border Margin="0,4,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Background="#1E1E22">
                                        <TextBlock x:Name="txtTransformHint" Style="{StaticResource Hint}" Foreground="#D8D8D8"
                                                   Text="Step 3: Click Apply Update to write processed source values into the selected target parameter."/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Existing value handling:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#B0B0B8"/>
                            <ComboBox x:Name="cmbExistingValueHandling" Width="270" SelectionChanged="persist_inputs_changed" SelectedIndex="0">
                                <ComboBoxItem Content="Override Existing Values"/>
                                <ComboBoxItem Content="Skip Elements With Existing Value"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Close" Click="close_click" Width="100"/>
                            <Button Content="Apply Update" Click="apply_update_click" Width="150" Style="{StaticResource ApplyButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
    </Grid>
</Window>
