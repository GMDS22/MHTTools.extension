<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Manager - By GM"
        Height="860"
        Width="1080"
        MinWidth="940"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1C"
        Foreground="#E8E8E8"
        Loaded="window_loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#232327"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A9A"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0E639C"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1FA6A6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F2B134"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#3A3A40"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#505058"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22B8B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#1A1A1C"/>
            <Setter Property="BorderBrush" Value="#D99A20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#E8E8E8"/>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="BtnBorder"
                    Background="#2A2A2E"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#33333A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"/>
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="#E8E8E8"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#303036"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#303036"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="8,2,28,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E8E8E8"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1E1E22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#0E639C"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Parameter Manager" FontSize="19" FontWeight="Bold" Margin="0,0,0,2"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="Step 1: Build filtered elements using Selection Filter style. Step 2: Process parameters on the filtered elements only."/>

        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="1. Filter Elements (Selection Filter Style)" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,2,0,8"
                           Text="Choose scope, search parameters, expand parameter nodes, check value nodes, then apply Keep/Unselect mode."/>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Scope:" VerticalAlignment="Center" Foreground="#B0B0B8"/>
                        <ComboBox x:Name="cmbScope" Grid.Column="1" SelectionChanged="scope_changed" ToolTip="Current Selection, Current View, or Entire Project."/>
                        <Button Grid.Column="2" Content="Reload Scope" Click="reload_scope_click" Style="{StaticResource SecondaryButton}" ToolTip="Reload elements from selected scope."/>
                        <TextBlock Grid.Column="3" Text="Category:" VerticalAlignment="Center" Foreground="#B0B0B8"/>
                        <ComboBox x:Name="cmbCategoryFilter" Grid.Column="4" SelectionChanged="category_filter_changed" ToolTip="Optional pre-filter by element category before parameter filtering."/>
                        <TextBlock Grid.Column="5" Text="Level:" VerticalAlignment="Center" Foreground="#B0B0B8"/>
                        <ComboBox x:Name="cmbLevelFilter" Grid.Column="6" SelectionChanged="level_filter_changed" ToolTip="Optional pre-filter by element level before parameter filtering."/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbFilterMode" Grid.Column="0" SelectedIndex="0" ToolTip="Keep Checked keeps matches. Unselect Checked removes matches.">
                            <ComboBoxItem Content="Keep Checked"/>
                            <ComboBoxItem Content="Unselect Checked"/>
                        </ComboBox>
                        <TextBox x:Name="txtFilterSearch" Grid.Column="1" TextChanged="filter_search_changed" ToolTip="Search parameter names in tree."/>
                        <Button Grid.Column="2" Content="Apply Filter" Click="apply_filter_click" Margin="0" Style="{StaticResource PrimaryButton}" ToolTip="Apply checked values to build filtered elements."/>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#1E1E22" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Hint}" Margin="0,0,0,4"
                                   Text="Parameters and Values: expand a parameter and check one or more values. AND across parameters, OR within checked values."/>
                        <TreeView x:Name="trvFilter" Grid.Row="1" ToolTip="Checked values define filter criteria."/>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Clear Filter" Click="clear_filter_click" Width="110" ToolTip="Reset filtered elements to full scope pool."/>
                    <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Background="#1E1E22" Margin="6,0,0,0">
                        <TextBlock x:Name="txtFilterSummary" Style="{StaticResource Hint}" Foreground="#D8D8D8"
                                   Text="No filter applied yet."/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" Background="#3A3A40" ToolTip="Drag to resize filter and processing sections."/>

        <Border Grid.Row="4" Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="2. Process Filtered Elements" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,2,0,8"
                           Text="Process applies only to filtered elements. Choose mode, target parameter, input mapping, then run."/>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Process mode:" VerticalAlignment="Center" Foreground="#B0B0B8"/>
                    <ComboBox x:Name="cmbProcessMode" Grid.Column="1" SelectionChanged="process_mode_changed" SelectedIndex="0" ToolTip="Direct Set writes one value. Copy Source reads from another parameter.">
                        <ComboBoxItem Content="Direct Set Value"/>
                        <ComboBoxItem Content="Copy Source Parameter"/>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Target parameter:" VerticalAlignment="Center" Foreground="#B0B0B8"/>
                    <ComboBox x:Name="cmbTargetParameter" Grid.Column="1" ToolTip="Writable parameter to update."/>
                </Grid>

                <Grid x:Name="pnlDirectMode" Grid.Row="4" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Direct value:" VerticalAlignment="Center" Foreground="#B0B0B8"/>
                    <TextBox x:Name="txtDirectValue" Grid.Column="1" ToolTip="Value written to all filtered elements in Direct mode."/>
                </Grid>

                <Grid x:Name="pnlSourceMode" Grid.Row="4" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source parameter:" VerticalAlignment="Center" Foreground="#B0B0B8"/>
                    <ComboBox x:Name="cmbSourceParameter" Grid.Row="0" Grid.Column="1" ToolTip="Readable source parameter value."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Transform:" VerticalAlignment="Center" Foreground="#B0B0B8" Margin="0,6,0,0"/>
                    <ComboBox x:Name="cmbTransform" Grid.Row="1" Grid.Column="1" Margin="0,6,6,0" SelectedIndex="0" ToolTip="Optional value transformation before write.">
                        <ComboBoxItem Content="Keep Original"/>
                        <ComboBoxItem Content="Uppercase"/>
                        <ComboBoxItem Content="Lowercase"/>
                        <ComboBoxItem Content="Trim Spaces"/>
                        <ComboBoxItem Content="Digits Only"/>
                        <ComboBoxItem Content="Dictionary Translate"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dictionary map:" VerticalAlignment="Top" Foreground="#B0B0B8" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtDictionary" Grid.Row="2" Grid.Column="1" Margin="0,6,6,0" Height="84" AcceptsReturn="True" TextWrapping="Wrap"
                             ToolTip="Used for Dictionary Translate. Format: key=value (one per line)."/>

                    <CheckBox x:Name="chkSkipExisting" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"
                              Content="Skip elements with existing target value"
                              ToolTip="Do not overwrite target values that are already populated."/>
                </Grid>

                <Border Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Background="#1E1E22" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="txtRunStatus" Text="Idle" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="prgRun" Height="16" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="txtRunCounts" Style="{StaticResource Hint}" Foreground="#D8D8D8" Margin="0,6,0,0"
                                   Text="Processed: 0 | Written: 0 | Skipped: 0 | Failed: 0"/>
                        <TextBlock x:Name="txtRunDetail" Style="{StaticResource Hint}" Foreground="#D8D8D8" Margin="0,4,0,0"
                                   Text="Current item: -"/>
                        <TextBlock x:Name="txtPoolSummary" Style="{StaticResource Hint}" Foreground="#D8D8D8" Margin="0,6,0,0"
                                   Text="Scope: 0 | Filtered: 0 | Written this session: 0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Content="Process Filtered Elements" Click="process_filtered_click" Width="190" Style="{StaticResource PrimaryButton}" ToolTip="Run writes on filtered elements only."/>
                    <Button Content="Cancel Running Process" Click="cancel_run_click" Width="190" Style="{StaticResource WarnButton}" ToolTip="Stop run and choose rollback or keep committed chunks."/>
                    <Button Content="Open Processing Monitor" Click="open_monitor_click" Width="185" ToolTip="Open per-element live monitor."/>
                    <Button Content="Close" Click="close_click" Width="90" Margin="0" ToolTip="Close Parameter Manager."/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Background="#1E1E22" Margin="0,10,0,0">
            <TextBlock x:Name="txtViewSummary" Style="{StaticResource Hint}" Foreground="#D8D8D8"
                       Text="Loading scope elements..."/>
        </Border>
    </Grid>
</Window>
