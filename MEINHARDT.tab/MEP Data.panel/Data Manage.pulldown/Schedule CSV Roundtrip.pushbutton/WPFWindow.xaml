<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Manager - By GM"
        Height="760"
        Width="1080"
        MinHeight="680"
        MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1C"
        Foreground="#E8E8E8"
        Loaded="window_loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#232327"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0E639C"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1177BB"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1FA6A6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F2B134"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A9A"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF7D"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="BandTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#3A3A40"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#505058"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22B8B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#1A1A1C"/>
            <Setter Property="BorderBrush" Value="#D99A20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#E8E8E8"/>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="BtnBorder"
                    Background="#2A2A2E"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#33333A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"/>
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="#E8E8E8"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#303036"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#303036"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="8,2,28,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E8E8E8"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1E1E22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E5D84"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="16" Background="#20242A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Schedule Manager" FontSize="22" FontWeight="Bold" Foreground="#E8E8E8"/>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Hint}"
                               Text="Export schedule-scoped instance parameters to CSV, manipulate values outside Revit, preview the impact, then reimport with verified writes and failure reporting."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="btnHeaderExport"
                            Style="{StaticResource HeaderActionButton}"
                            Background="#0E639C"
                            BorderBrush="#1177BB"
                            Foreground="#FFFFFF"
                            Content="Export"
                            Click="header_export_click"/>
                    <Button x:Name="btnHeaderPreview"
                            Style="{StaticResource HeaderActionButton}"
                            Background="#1FA6A6"
                            BorderBrush="#22B8B8"
                            Foreground="#FFFFFF"
                            Content="Preview"
                            Click="header_preview_click"/>
                    <Button x:Name="btnHeaderImport"
                            Style="{StaticResource HeaderActionButton}"
                            Background="#F2B134"
                            BorderBrush="#D99A20"
                            Foreground="#1A1A1C"
                            Content="Import"
                            Click="header_import_click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="Export Lane"/>
                    <TextBlock Grid.Row="1" Margin="0,4,0,0"
                               Style="{StaticResource Hint}"
                               Text="Exports the schedule exactly as displayed: all visible columns and displayed values. Import still writes only supported writable parameter-backed columns."/>

                    <TextBlock Grid.Row="2" Style="{StaticResource SectionLabel}" Text="Schedule"/>
                    <TextBox Grid.Row="3"
                             x:Name="txtScheduleSearch"
                             Margin="0,0,0,4"
                             ToolTip="Type to filter schedules by name"
                             TextChanged="schedule_search_changed"/>
                    <ComboBox Grid.Row="4" x:Name="cmbSchedule" SelectionChanged="schedule_changed"/>

                    <TextBlock Grid.Row="5" Style="{StaticResource SectionLabel}" Text="Schedule Snapshot"/>
                    <TextBlock Grid.Row="6" x:Name="txtScheduleSummary"
                               TextWrapping="Wrap"
                               Foreground="#E8E8E8"
                               Background="#1E1E22"
                               Padding="10"
                               MinHeight="78"/>

                    <StackPanel Grid.Row="7">
                        <CheckBox x:Name="chkExportWritableOnly"
                                  Content="Include hidden schedule columns when possible (best-effort values)"
                                  IsChecked="False"
                                  Click="export_options_changed"/>
                        <CheckBox x:Name="chkIncludeElementIds"
                                  Content="Include ElementId and UniqueId metadata columns for safe reimport"
                                  IsChecked="True"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <Grid Grid.Row="8" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="Export Format" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="cmbExportFormat" SelectedIndex="0" SelectionChanged="export_format_changed">
                            <ComboBoxItem Content="CSV"/>
                            <ComboBoxItem Content="Excel"/>
                        </ComboBox>
                    </Grid>

                    <GridSplitter Grid.Row="9"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeDirection="Rows"
                                  Background="#3A3A40"
                                  ToolTip="Drag to resize the exported fields area."/>

                    <Grid Grid.Row="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="Exported Fields"/>
                        <ListBox Grid.Row="1" x:Name="lstFieldSummary" MinHeight="120"/>
                    </Grid>

                    <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="btnRefreshSchedules"
                                Style="{StaticResource SecondaryButton}"
                                Content="Refresh Schedules"
                                Click="refresh_schedules_click"/>
                        <Button x:Name="btnExportCsv"
                                Style="{StaticResource PrimaryButton}"
                                Content="Export CSV"
                                Click="export_csv_click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="Import Lane"/>
                    <TextBlock Grid.Row="1" Margin="0,4,0,0"
                               Style="{StaticResource Hint}"
                               Text="Preview the CSV before writing. Import matches rows by ElementId or UniqueId, verifies each write, and reports skipped and failed cells separately."/>

                    <TextBlock Grid.Row="2" Style="{StaticResource SectionLabel}" Text="CSV File"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtImportPath" Grid.Column="0" MinWidth="320"/>
                        <Button x:Name="btnBrowseImport"
                                Grid.Column="1"
                                Content="Browse"
                                Click="browse_import_click"/>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <CheckBox x:Name="chkSkipBlankIncoming"
                                  Content="Skip blank incoming values instead of clearing anything"
                                  IsChecked="True"/>
                        <CheckBox x:Name="chkStopOnFailure"
                                  Content="Stop the import on the first verification failure"
                                  IsChecked="False"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="Target Mode"/>
                            <ComboBox x:Name="cmbParameterTargetMode" Width="230"
                                      SelectionChanged="parameter_target_mode_changed">
                                <ComboBoxItem Content="SharedOnly (recommended)" Tag="SharedOnly"/>
                                <ComboBoxItem Content="Both (shared + legacy duplicates)" Tag="Both"/>
                                <ComboBoxItem Content="FamilyOnly / non-shared only" Tag="FamilyOnly"/>
                                <ComboBoxItem Content="FirstMatch (diagnostic fallback)" Tag="FirstMatch"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="Import Preview"/>
                        <TextBlock Grid.Row="1" x:Name="txtImportSummary"
                                   TextWrapping="Wrap"
                                   Foreground="#E8E8E8"
                                   Background="#1E1E22"
                                   Padding="10"
                                   MinHeight="78"/>
                    </Grid>

                    <GridSplitter Grid.Row="6"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeDirection="Rows"
                                  Background="#3A3A40"
                                  ToolTip="Drag to resize the preview table area."/>

                    <Grid Grid.Row="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="Preview Table"/>
                        <ListView Grid.Row="1" x:Name="lvwImportPreview" MinHeight="120">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Row" Width="60" DisplayMemberBinding="{Binding Row}"/>
                                    <GridViewColumn Header="ElementId" Width="90" DisplayMemberBinding="{Binding ElementId}"/>
                                    <GridViewColumn Header="Column" Width="190" DisplayMemberBinding="{Binding Column}"/>
                                    <GridViewColumn Header="Current" Width="160" DisplayMemberBinding="{Binding Current}"/>
                                    <GridViewColumn Header="Incoming" Width="160" DisplayMemberBinding="{Binding Incoming}"/>
                                    <GridViewColumn Header="Status" Width="130" DisplayMemberBinding="{Binding Status}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="btnPreviewImport"
                                Style="{StaticResource SecondaryButton}"
                                Content="Preview Import"
                                Click="preview_import_click"/>
                        <Button x:Name="btnApplyImport"
                                Style="{StaticResource AccentButton}"
                                Content="Apply Import"
                                Click="apply_import_click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Activity Log"/>
                <TextBlock Margin="0,4,0,8"
                           Style="{StaticResource Hint}"
                           Text="Recent actions, validations, and write results appear here."/>
                <TextBox x:Name="txtLog"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Background="#20242A" Margin="0,0,0,0">
            <TextBlock x:Name="txtStatus"
                       Text="Ready. Choose a schedule to inspect its exportable fields."
                       Foreground="#E8E8E8"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>