<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Flow Processor - Processing Monitor"
        Height="560"
        Width="980"
        MinWidth="760"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1C"
        Foreground="#E8E8E8"
        Topmost="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Live Processing Monitor" FontSize="17" FontWeight="Bold" Margin="0,0,0,2"/>
        <TextBlock x:Name="txtMonitorStatus" Grid.Row="1" Margin="0,0,0,8" Foreground="#C5C5CF" TextWrapping="Wrap"
                   Text="Waiting for processing run..."/>

        <ListBox x:Name="lstMonitorItems"
                 Grid.Row="2"
                 SelectionMode="Single"
                 SelectionChanged="monitor_selection_changed"
                 Background="#1E1E22"
                 Foreground="#E8E8E8"
                 BorderBrush="#3A3A40"
                 BorderThickness="1"
                 FontFamily="Consolas"
                 FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Center Selected ID"
                    Click="center_selected_click"
                    Width="150"
                    Margin="0,0,8,0"
                    Background="#0E639C"
                    Foreground="#FFFFFF"
                    BorderBrush="#1177BB"
                    BorderThickness="1"
                    Padding="12,6"/>
            <Button Content="Clear"
                    Click="clear_monitor_click"
                    Width="90"
                    Margin="0,0,8,0"
                    Background="#3A3A40"
                    Foreground="#E8E8E8"
                    BorderBrush="#505058"
                    BorderThickness="1"
                    Padding="12,6"/>
            <Button Content="Close"
                    Click="close_monitor_click"
                    Width="90"
                    Background="#3A3A40"
                    Foreground="#E8E8E8"
                    BorderBrush="#505058"
                    BorderThickness="1"
                    Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>
